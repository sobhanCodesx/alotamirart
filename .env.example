# Copy this file to .env in the project root using cPanel File Manager.
# NEVER upload the real .env to GitHub. Do not surround values with extra spaces.
# Use single or double quotes if a value contains spaces or #.

APP_ENV=production
APP_DEBUG=0
APP_TIMEZONE=Asia/Tehran

# Main website database credentials (from cPanel MySQL Databases)
DB_HOST=localhost
DB_NAME=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD="replace_with_your_password"

# Optional: only set these if legacy pages use a different database.
# DB_LEGACY_HOST=localhost
# DB_LEGACY_NAME=your_legacy_database
# DB_LEGACY_USERNAME=your_legacy_user
# DB_LEGACY_PASSWORD="your_legacy_password"

# Content MCP - set a private random token with at least 32 characters.
MCP_API_TOKEN=replace_with_your_long_random_secret_at_least_32_chars
MCP_AUTHOR_USER_ID=1
MCP_ALLOW_PUBLISH=0

# Enables the signed GitHub Actions deploy receiver only after manual bootstrap.
ALO_DEPLOY_ENABLED=0

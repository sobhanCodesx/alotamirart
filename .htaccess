RewriteEngine On
RewriteBase /

# ===== هدایت به HTTPS =====
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ===== اگر فایل یا پوشه وجود دارد، تغییر مسیر نده =====
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f

# ===== هدایت آدرس‌های سئو شده به service-city.php =====
RewriteRule ^refrigerator-repair-in-([a-zA-Z0-9-]+)$ service-city.php?service=refrigerator&city=$1 [L,QSA]
RewriteRule ^washing-machine-repair-in-([a-zA-Z0-9-]+)$ service-city.php?service=washing-machine&city=$1 [L,QSA]
RewriteRule ^air-conditioner-repair-in-([a-zA-Z0-9-]+)$ service-city.php?service=air-conditioner&city=$1 [L,QSA]
RewriteRule ^tv-repair-in-([a-zA-Z0-9-]+)$ service-city.php?service=tv&city=$1 [L,QSA]
RewriteRule ^oven-repair-in-([a-zA-Z0-9-]+)$ service-city.php?service=oven&city=$1 [L,QSA]
RewriteRule ^dishwasher-repair-in-([a-zA-Z0-9-]+)$ service-city.php?service=dishwasher&city=$1 [L,QSA]

# ===== هدایت آدرس‌های خدمات شهر =====
RewriteRule ^services-in-([a-zA-Z0-9-]+)$ show-city.php?city=$1 [L,QSA]

# ===== هدایت لیست شهرها =====
RewriteRule ^cities$ cities/index.php [L,QSA]

# ===== اگر هیچکدام از قوانین بالا اجرا نشد =====
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.+)$ index.php [QSA,L]
ErrorDocument 404 /404.php
RewriteRule ^washing-machine-repair-in-([a-zA-Z0-9-]+)$ service-washing-machine.php?city=$1 [L,QSA]
## Prevent HTTP access to project-root .env files.
<FilesMatch "(?i)^\.env(?:\..*)?$">
    Require all denied
</FilesMatch>

RewriteEngine On
RewriteBase /

# PlayNexus-style clean MCP endpoint. Run this BEFORE the real-file rule.
# Apache keeps the public request path /api/mcp and internally serves PHP.
RewriteRule ^api/mcp/?$ api/mcp.php [END,QSA,NC]

# Force HTTPS while keeping the original path/query.
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Real files and directories (assets, uploads, robots.txt, etc.) are served directly.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Legacy routing contract (kept as documentation for backward compatibility):
# service-city.php?service=refrigerator&city=$1
# service-city.php?service=washing-machine&city=$1
# show-city.php?city=$1
#
# All application URLs go through the existing front controller.
# This keeps old public URLs unchanged while allowing the router to resolve them consistently.
RewriteRule ^ index.php [QSA,L]

ErrorDocument 404 /404.php

# Long-lived browser caching for versioned static assets.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\\.(?:css|js|png|jpe?g|webp|svg|ico|woff2?|ttf|otf)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>
